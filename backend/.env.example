# ==============================================================================
# AVO ERP - Environment Configuration
# Note: Database connection auto-switches between local and production!
#   - Local (localhost/127.0.0.1)      -> DB: avo_erp, User: root, Pass: empty
#   - Production (avo.sarsspl.com)     -> DB: u444388293_avo_erp, User: u444388293_avo_erp
# ==============================================================================

# APP_ENV: 'development' (local) or 'production' (server)
APP_ENV=development
APP_DEBUG=true

# Database Settings (Uncomment/override if needed)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# Local Defaults:
DB_DATABASE=avo_erp
DB_USERNAME=root
DB_PASSWORD=

# Production (avo.sarsspl.com) Defaults:
# DB_DATABASE=u444388293_avo_erp
# DB_USERNAME=u444388293_avo_erp
# DB_PASSWORD=AVav@@2026

# Security & JWT Token
JWT_SECRET=super-secret-avo-erp-key-2026-production-3d-tuple
JWT_EXPIRATION=86400
